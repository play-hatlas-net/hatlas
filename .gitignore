# MacOS DS_Store files
.DS_Store
.claude/*
# Shared Claude Code config (hooks, agents, skills); settings.local.json stays personal
!.claude/settings.json
!.claude/agents/
!.claude/skills/
!.claude/hooks/

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory
run

# Local secrets (RCON password, DB password)
.env

# Map pipeline: exported worlds, WorldPainter projects, generated outputs, venv
worldgen/template/
worldgen/*.world
worldgen/out/
worldgen/.venv/

# Boss pipeline: third-party reference images (mood only, OQ 122)
bosses/**/refs/private/
bosses/_tools/.venv/
bosses/_tools/__pycache__/
